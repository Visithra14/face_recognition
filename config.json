{
  "source": {
    "type": "file",
    "path": "data/video_sample1.mp4",
    "rtsp_url": ""
  },
  "detection_skip_frames": 1,
  "detector": {
    "model_path": "models/yolov8n-face.pt",
    "conf_threshold": 0.5,
    "input_size": 640
  },
  "recognition": {
    "model_name": "buffalo_sc",
    "similarity_threshold": 0.45,
    "reverify_every_n_frames": 30
  },
  "tracking": {
    "algorithm": "bytetrack",
    "min_confirm_frames": 5,
    "exit_patience_frames": 30
  },
  "quality": {
    "min_face_size": 40,
    "blur_threshold": 50.0
  },
  "storage": {
    "db_path": "data/faces.db",
    "log_dir": "logs"
  },
  "device": "auto",
  "display": {
    "show_overlay": true,
    "save_output_video": true
  }
}
